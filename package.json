{
  "name": "@poort/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:deps": "node tooling/guard/check-deps.ts",
    "check:lines": "node tooling/guard/check-lines.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:deps && pnpm check:lines",
    "db:generate": "pnpm --filter @poort/db generate",
    "db:migrate": "node packages/db/src/migrate.ts",
    "start:poort": "node apps/poort/src/server.ts",
    "start:proefapp": "node apps/proefapp/src/server.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.0"
    }
  }
}
