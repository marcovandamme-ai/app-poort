# Intern stadium: HTTPS wordt afgehandeld door `tailscale serve` op de node;
# Caddy luistert alleen lokaal (zie docker-compose.yml).
{
	auto_https off
	admin off
}

# Eén app achter de poort: `import achter_poort <slug> <upstream>`.
# `route` houdt de volgorde vast zoals hij hier staat; zonder `route` sorteert Caddy de
# regels en zou hij de identiteit van de poort weer weghalen (bevinding B-003).
(achter_poort) {
	route {
		# 1. Weghalen wat de bezoeker zelf meestuurt (CVE-2026-30851).
		request_header -X-Poort-User
		request_header -X-Poort-Entitlements
		# 2. De poort vragen. De app-naam staat hier vast: de bezoeker kan hem niet kiezen.
		forward_auth poort:3000 {
			uri /gate/verify
			header_up X-Poort-App {args[0]}
			copy_headers X-Poort-User X-Poort-Entitlements
		}
		# 3. Doorsturen zonder de cookies van de poort (naam begint met `poort.`): een app krijgt
		#    de sessie nooit in handen. Set-Cookie-koppen van een app met zo'n naam worden gewist.
		#    Scripts op een app-pagina kunnen nog wel cookies zetten zolang poort en apps één
		#    hostnaam delen (B-006/B-026); dat vervalt met een eigen hostnaam voor de poort.
		reverse_proxy {args[1]} {
			header_up Cookie "(^|; *)(__Secure-|__Host-)?poort[.][^=;]*=[^;]*" ""
			header_up Cookie "^(; *)+" ""
			header_down Set-Cookie "^[ =]*(__Secure-|__Host-)?poort[.].*$" ""
		}
	}
}

# De poort zelf. /gate/* is alleen voor Caddy, nooit voor bezoekers.
:8080 {
	@gate path /gate /gate/*
	respond @gate 404
	reverse_proxy poort:3000
}

# Proefapp. Een nieuwe app aansluiten = zo'n blok met een eigen poort,
# plus één regel in de tabel `app`.
:8081 {
	import achter_poort proefapp proefapp:3001
}
