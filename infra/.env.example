# Kopieer naar infra/.env op de node en vul in. Nooit committen, nooit in een chat plakken.
# Maak het wachtwoord met: openssl rand -hex 32
POSTGRES_PASSWORD=
# Adres waarop bezoekers de poort bereiken (alleen https://naam:poort, niets erachter)
PUBLIC_URL=https://node3.tail489231.ts.net:8450
# Adres waarop bezoekers de proefapp bereiken
PROEFAPP_URL=https://node3.tail489231.ts.net:8451
POORT_PORT=8450
PROEFAPP_PORT=8451
APP_VERSION=dev
# Alleen "true" op een eigen domein dat niets anders dan HTTPS serveert.
HSTS=false
